// ============================================================
// HomeEase — Schéma de base de données (PostgreSQL via Prisma)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------
// ENUMS
// ---------------------------

enum Role {
  USER
  OWNER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum TransactionType {
  RENT
  SALE
  SHORT_STAY
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RESERVED
  RENTED
  SOLD
  ARCHIVED
  REJECTED
}

enum LandDocumentStatus {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
}

enum ViewingRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  KKIAPAY
  MTN_MOMO
  CARD
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum VerificationType {
  PHONE
  IDENTITY
  PROFESSIONAL
  PROPERTY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------
// USERS
// ---------------------------

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  email         String?  @unique
  passwordHash  String?
  role          Role     @default(USER)
  isPhoneVerified    Boolean @default(false)
  isIdentityVerified Boolean @default(false)
  isProVerified      Boolean @default(false)
  isSuperOwner       Boolean @default(false)
  isSuspended        Boolean @default(false)
  isBanned           Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile        Profile?
  properties     Property[]          @relation("OwnerProperties")
  agentProperties Property[]         @relation("AgentProperties")
  favorites      Favorite[]
  viewingRequestsAsClient Booking[]  @relation("ClientBookings")
  bookings       Booking[]           @relation("BookingClient")
  viewingRequests ViewingRequest[]   @relation("ViewingClient")
  payments       Payment[]
  reviewsGiven   Review[]            @relation("ReviewAuthor")
  reviewsReceived Review[]           @relation("ReviewTarget")
  notifications  Notification[]
  reports        Report[]            @relation("ReportAuthor")
  sentMessages   Message[]
  conversations  ConversationParticipant[]
  verificationRequests VerificationRequest[]
  adminActions   AdminAction[]       @relation("AdminActor")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  firstName String?
  lastName  String?
  avatarUrl String?
  bio       String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------
// CATEGORIES
// ---------------------------

model Category {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  properties  Property[]
}

// ---------------------------
// PROPERTIES
// ---------------------------

model Location {
  id         String   @id @default(uuid())
  city       String
  commune    String?
  quarter    String?
  latitude   Float?
  longitude  Float?
  property   Property?
}

model Property {
  id               String          @id @default(uuid())
  ownerId          String
  owner            User            @relation("OwnerProperties", fields: [ownerId], references: [id])
  agentId          String?
  agent            User?           @relation("AgentProperties", fields: [agentId], references: [id])
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])

  title            String
  description      String
  transactionType  TransactionType
  price            Decimal         @db.Decimal(12, 2)
  currency         String          @default("XOF")

  bedrooms         Int?
  rooms            Int?
  hasInternalShower Boolean        @default(false)
  hasInternalToilet Boolean        @default(false)
  hasParking        Boolean        @default(false)
  hasWater          Boolean        @default(false)
  hasElectricity    Boolean        @default(false)
  hasWifi           Boolean        @default(false)
  isFurnished       Boolean        @default(false)
  surfaceArea       Float?

  // Champs spécifiques terrain/parcelle
  landAccess           String?
  landLotissement      String?
  landIsServiced       Boolean?
  landDocumentsStatus  LandDocumentStatus?

  isVerified       Boolean         @default(false)
  isDemo           Boolean         @default(false)
  isFeatured       Boolean         @default(false)
  featuredUntil    DateTime?
  status           PropertyStatus  @default(DRAFT)
  viewsCount       Int             @default(0)

  locationId       String?         @unique
  location         Location?       @relation(fields: [locationId], references: [id])

  images           PropertyImage[]
  videos           PropertyVideo[]
  features         PropertyFeature[]
  favorites        Favorite[]
  viewingRequests  ViewingRequest[]
  bookings         Booking[]
  reviews          Review[]
  reports          Report[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([transactionType])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  sortOrder  Int      @default(0)
}

model PropertyVideo {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
}

// Caractéristiques additionnelles libres (clé/valeur) pour rester extensible
// sans migration à chaque nouvelle catégorie (voitures, meubles, tourisme...).
model PropertyFeature {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  key        String
  value      String
}

// ---------------------------
// FAVORIS
// ---------------------------

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

// ---------------------------
// DEMANDES DE VISITE
// ---------------------------

model ViewingRequest {
  id          String               @id @default(uuid())
  propertyId  String
  property    Property             @relation(fields: [propertyId], references: [id])
  clientId    String
  client      User                 @relation("ViewingClient", fields: [clientId], references: [id])
  requestedDate DateTime
  message     String?
  status      ViewingRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

// ---------------------------
// RÉSERVATIONS
// ---------------------------

model Booking {
  id           String        @id @default(uuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id])
  clientId     String
  client       User          @relation("BookingClient", fields: [clientId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  guestsCount  Int?
  basePrice    Decimal       @db.Decimal(12, 2)
  fees         Decimal       @db.Decimal(12, 2) @default(0)
  commission   Decimal       @db.Decimal(12, 2) @default(0)
  totalPrice   Decimal       @db.Decimal(12, 2)
  status       BookingStatus @default(PENDING)
  payments     Payment[]
  reviews      Review[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  User User[] @relation("ClientBookings")
}

// ---------------------------
// PAIEMENTS
// ---------------------------

model Payment {
  id                    String          @id @default(uuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id])
  bookingId             String?
  booking               Booking?        @relation(fields: [bookingId], references: [id])
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("XOF")
  provider              PaymentProvider
  transactionReference  String          @unique
  status                PaymentStatus   @default(PENDING)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

// ---------------------------
// MESSAGERIE
// ---------------------------

model Conversation {
  id           String                    @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  isBlocked      Boolean      @default(false)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ---------------------------
// AVIS
// ---------------------------

model Review {
  id         String    @id @default(uuid())
  authorId   String
  author     User      @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId   String
  target     User      @relation("ReviewTarget", fields: [targetId], references: [id])
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
}

// ---------------------------
// NOTIFICATIONS
// ---------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------
// SIGNALEMENTS
// ---------------------------

model Report {
  id         String       @id @default(uuid())
  authorId   String
  author     User         @relation("ReportAuthor", fields: [authorId], references: [id])
  propertyId String?
  property   Property?    @relation(fields: [propertyId], references: [id])
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
}

// ---------------------------
// VÉRIFICATIONS
// ---------------------------

model VerificationRequest {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      VerificationType
  status    VerificationStatus  @default(PENDING)
  documentUrl String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ---------------------------
// ACTIONS ADMIN (audit log)
// ---------------------------

model AdminAction {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminActor", fields: [adminId], references: [id])
  action    String
  targetType String
  targetId   String
  details    String?
  createdAt DateTime @default(now())
}

// ---------------------------
// AUTHENTIFICATION — OTP par téléphone
// ---------------------------

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// ---------------------------
// PARAMÈTRES (commissions, frais...) — configurable, jamais en dur
// ---------------------------

model Setting {
  key   String @id
  value String
}
